# Application
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (NestJS App)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payments_db

# Postgres Container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments_db

# Database (TypeORM CLI / Migrations - mirroring above)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=payments_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://localhost:5672

# PaymentHub Adapter
PAYMENTHUB_API_BASE_URL=https://api.paymenthub.example.com
PAYMENTHUB_API_KEY=paymenthub_api_key

# Aspin Adapter
ASPIN_API_BASE_URL=https://api.aspin.example.com
ASPIN_API_KEY=aspin_api_key
ASPIN_ADAPTER_SIGNATURE_SECRET=aspin_adapter_signature_secret

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
